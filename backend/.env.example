# Model keys: a model shows up in the game only when its key is set.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=          # optional: enables level 0 (uncensored model)

# Optional model overrides (defaults in app/config.py)
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=qwen/qwen3.6-27b

SECRET_KEY=                  # long random string; changing it changes every level's code
FRONTEND_ORIGIN=http://localhost:3000
DAILY_BUDGET_USD=1.00

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=        # optional bot check

ENABLE_MOCK_MODEL=0          # 1 = offer a fake model for local testing without keys
